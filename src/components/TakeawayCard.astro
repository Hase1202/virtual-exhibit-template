---
/*
 * TakeawayCard.astro — Large summary card for key takeaways.
 * Shows a number badge, headline statement, and supporting explanation.
 */

interface Props {
  number: number;
  headline: string;
  description: string;
  accent?: string;
}

const { number, headline, description, accent = "#38bdf8" } = Astro.props;
---

<div class="takeaway" style={`--ta-accent: ${accent};`}>
  <div class="takeaway__badge">{number}</div>
  <h3 class="takeaway__headline">{headline}</h3>
  <p class="takeaway__desc">{description}</p>
</div>

<style>
  .takeaway {
    position: relative;
    background: rgba(13, 17, 32, 0.65);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    padding: 2.5rem 1.75rem 2rem;
    text-align: center;
    overflow: hidden;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .takeaway::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--ta-accent);
    opacity: 0.8;
  }

  .takeaway:hover {
    border-color: var(--ta-accent);
    transform: translateY(-5px);
    box-shadow:
      0 12px 35px rgba(0, 0, 0, 0.5),
      0 0 15px var(--ta-accent);
  }

  .takeaway__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--ta-accent), #818cf8);
    color: #070913;
    font-size: 1.3rem;
    font-weight: 800;
    margin-bottom: 1.25rem;
    box-shadow: 0 4px 12px var(--ta-accent);
    transition: transform 0.3s ease;
  }

  .takeaway:hover .takeaway__badge {
    transform: scale(1.1);
  }

  .takeaway__headline {
    font-size: 1.2rem;
    font-weight: 800;
    color: #faf8ff;
    margin: 0 0 0.75rem;
    line-height: 1.3;
  }

  .takeaway__desc {
    font-size: 0.88rem;
    color: #b0a6d9;
    line-height: 1.65;
    margin: 0;
  }
</style>
