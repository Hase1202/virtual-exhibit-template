---
/*
 * ConceptCard.astro — Glassmorphism card with icon, title, and description.
 * Used for the four concept cards (Fragmentation, Paging, Page Table, Virtual Memory).
 */

interface Props {
  icon: string;
  title: string;
  description: string;
  accent?: string;
}

const { icon, title, description, accent = "var(--ml-accent)" } = Astro.props;
---

<div class="concept-card" style={`--card-accent: ${accent};`}>
  <div class="concept-card__icon-ring">
    <span class="concept-card__icon">
      {icon === 'fragmentation' && (
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7" rx="1"></rect>
          <rect x="14" y="3" width="7" height="7" rx="1"></rect>
          <rect x="14" y="14" width="7" height="7" rx="1"></rect>
          <rect x="3" y="14" width="7" height="7" rx="1" stroke-dasharray="2 2" opacity="0.5"></rect>
        </svg>
      )}
      {icon === 'paging' && (
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
          <polygon points="2 17 12 22 22 17"></polygon>
          <polygon points="2 12 12 17 22 12"></polygon>
        </svg>
      )}
      {icon === 'page-table' && (
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="3" y1="9" x2="21" y2="9"></line>
          <line x1="3" y1="15" x2="21" y2="15"></line>
          <line x1="12" y1="3" x2="12" y2="21"></line>
        </svg>
      )}
      {icon === 'virtual-memory' && (
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect>
          <rect x="9" y="9" width="6" height="6"></rect>
          <line x1="9" y1="1" x2="9" y2="4"></line>
          <line x1="15" y1="1" x2="15" y2="4"></line>
          <line x1="9" y1="20" x2="9" y2="23"></line>
          <line x1="15" y1="20" x2="15" y2="23"></line>
          <line x1="20" y1="9" x2="23" y2="9"></line>
          <line x1="20" y1="15" x2="23" y2="15"></line>
          <line x1="1" y1="9" x2="4" y2="9"></line>
          <line x1="1" y1="15" x2="4" y2="15"></line>
        </svg>
      )}
    </span>
  </div>
  <h3 class="concept-card__title">{title}</h3>
  <p class="concept-card__desc">{description}</p>
  <div class="concept-card__glow" aria-hidden="true"></div>
</div>

<style>
  .concept-card {
    position: relative;
    background: rgba(13, 17, 32, 0.65);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 2rem 1.5rem 1.75rem;
    text-align: center;
    overflow: hidden;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: default;
  }

  .concept-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--card-accent);
    opacity: 0.7;
    transition: opacity 0.35s ease, height 0.35s ease;
  }

  .concept-card:hover {
    border-color: var(--card-accent);
    transform: translateY(-6px);
    box-shadow:
      0 12px 35px rgba(0, 0, 0, 0.4),
      0 0 15px var(--card-accent);
  }

  .concept-card__glow {
    position: absolute;
    bottom: -40px;
    left: 50%;
    transform: translateX(-50%);
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: var(--card-accent);
    opacity: 0;
    filter: blur(50px);
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .concept-card:hover .concept-card__glow {
    opacity: 0.15;
  }

  .concept-card__icon-ring {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--card-accent);
    margin-bottom: 1.15rem;
    transition: all 0.35s ease;
  }

  .concept-card:hover .concept-card__icon-ring {
    transform: scale(1.1) rotate(5deg);
    background: var(--card-accent);
    border-color: var(--card-accent);
    color: #070913;
    box-shadow: 0 0 10px var(--card-accent);
  }

  .concept-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .concept-card__title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #faf8ff;
    margin: 0 0 0.6rem;
    letter-spacing: 0.3px;
  }

  .concept-card__desc {
    font-size: 0.85rem;
    color: #b0a6d9;
    line-height: 1.6;
    margin: 0;
  }
</style>
