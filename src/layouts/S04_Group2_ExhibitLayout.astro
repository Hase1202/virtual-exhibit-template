---
const { title, author, readingTime } = Astro.props.frontmatter ?? Astro.props;
const { headings } = Astro.props; 

import 'normalize.css';
import '@fontsource-variable/lora';
import '@fontsource-variable/noto-sans';

import '../styles/global.css'; 

import { Icon } from 'astro-icon/components';

const baseUrl = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title} - CSARCH2 Virtual Exhibit</title>
    </head>

    <body class="ml-page">
        <header class="header">
            <div class="header__titleblock">
                <a href={baseUrl} class="button">
                    <Icon name="ic:round-home" />
                </a>

                <strong>{title}</strong>
                <span class="header__subtitle">by {author}</span>
            </div>
        </header>

        <main>
            <article>
                <slot />
            </article>
        </main>

        <footer class="ml-footer">CSARCH2 Virtual Exhibit &mdash; "Computer Architecture is Forever"</footer>
    </body>
</html>

<style>
    .header {
        padding: 1.5rem 1.5rem 0.5rem;
        background: transparent;
    }

    .header__titleblock {
        background: var(--ml-bg-glass);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--ml-border);
        border-radius: var(--ml-radius-md);
        box-shadow: var(--ml-shadow-card);
        color: var(--ml-text);
        padding: 0.75rem 1.25rem;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    .header__titleblock strong {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        font-weight: 700;
        color: var(--ml-heading);
    }

    .header__subtitle {
        color: var(--ml-text-dim);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    .button {
        background: var(--ml-bg-glass);
        border: 1px solid var(--ml-border);
        color: var(--ml-text-muted);
        border-radius: 50%;
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        transition: all var(--ml-transition);
        box-shadow: none;
        text-decoration: none;
    }

    .button:hover {
        background: var(--ml-accent-dim);
        color: var(--ml-text);
    }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.animate-fade-up, .animate-fade-in').forEach((el) => {
      observer.observe(el);
    });

    // Scroll Progress Line Bar Listener
    const scrollProgress = document.getElementById('scrollProgress');
    if (scrollProgress) {
      window.addEventListener('scroll', () => {
        const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = (window.scrollY / totalHeight) * 100;
        scrollProgress.style.width = `${Math.min(100, Math.max(0, progress))}%`;
      });
    }
  });
</script>
