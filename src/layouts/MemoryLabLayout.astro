---
/*
 * MemoryLabLayout.astro
 * Custom layout for the Virtual Memory exhibit.
 * Does not modify the existing ExhibitLayout or HomepageLayout.
 * NOTE: CSS theme is imported from the page, not here, to avoid esbuild conflicts.
 */

const { title = "Virtual Memory: How It Works" } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;

const fontUrl = "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="An interactive virtual exhibit explaining how virtual memory solves external fragmentation." />
    <title>{title} - CSARCH2 Virtual Exhibit</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontUrl} rel="stylesheet" />
  </head>

  <body class="ml-page">
    <nav class="ml-nav" aria-label="Main navigation">
      <a href={baseUrl} class="ml-nav__brand">
        <span class="ml-nav__brand-icon" aria-hidden="true">&#x1F9E0;</span>
        Memory Lab
      </a>
      <ul class="ml-nav__links">
        <li><a href="#concepts" class="ml-nav__link">Concepts</a></li>
        <li><a href="#simulator" class="ml-nav__link">Simulator</a></li>
        <li><a href="#deep-dive" class="ml-nav__link">Deep Dive</a></li>
        <li><a href="#takeaways" class="ml-nav__link">Takeaways</a></li>
        <li><a href="#references" class="ml-nav__link">References</a></li>
      </ul>
    </nav>

    <slot />

    <footer class="ml-footer">
      CSARCH2 Virtual Exhibit
    </footer>
  </body>
</html>

<style>
  html {
    scroll-behavior: smooth;
    background: none !important;
  }
</style>
